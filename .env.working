# === Startup Commands (Copy & Paste) ===
# Use these exact commands for starting services:

# 1. Start TimescaleDB:
# docker run -d --name adam-timescaledb \
#   -p 5433:5432 \
#   -e POSTGRES_DB=adam_counters \
#   -e POSTGRES_USER=industrial_system \
#   -e POSTGRES_PASSWORD=IndustrialCounter2024!@#$ \
#   timescale/timescaledb:2.17.2-pg17

# 2. Start Logger API (Port 5000):
# cd src/Industrial.Adam.Logger.WebApi
# ASPNETCORE_URLS=http://localhost:5000 \
# TIMESCALEDB_USERNAME=industrial_system \
# TIMESCALEDB_PASSWORD=IndustrialCounter2024!@#$ \
# JWT_SECRET_KEY=8f9e2a1b5c6d3e7f4g8h9i2j5k6l3m7n8o9p2q5r6s3t7u8v9w2x5y6z3a7b8c9d \
# JWT_ISSUER=Industrial.Adam.System \
# JWT_AUDIENCE=Industrial.Adam.APIs \
# dotnet run

# 3. Start OEE API (Port 5001):
# cd src/Industrial.Adam.Oee/WebApi
# ASPNETCORE_URLS=http://localhost:5001 \
# TIMESCALEDB_USERNAME=industrial_system \
# TIMESCALEDB_PASSWORD=IndustrialCounter2024!@#$ \
# JWT_SECRET_KEY=8f9e2a1b5c6d3e7f4g8h9i2j5k6l3m7n8o9p2q5r6s3t7u8v9w2x5y6z3a7b8c9d \
# JWT_ISSUER=Industrial.Adam.System \
# JWT_AUDIENCE=Industrial.Adam.APIs \
# dotnet run

# === Health Check URLs ===
# Logger API: http://localhost:5000/health
# OEE API: http://localhost:5001/health
# Database: psql postgresql://industrial_system:IndustrialCounter2024!@#$@localhost:5433/adam_counters

# === IMPORTANT NOTES ===
# 1. These credentials passed security validation tests
# 2. The JWT key meets minimum length requirements
# 3. Ports 5000 and 5001 avoid conflicts with default configurations
# 4. Environment variables MUST be set before running dotnet run
# 5. See docs/SETUP_TROUBLESHOOTING.md for detailed guidance