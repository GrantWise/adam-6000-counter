{
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Environment": "Development"
    }
  },
  "IndustrialSecurity": {
    "JwtSettings": {
      "RequireHttps": false
    },
    "RateLimiting": {
      "Enabled": false
    }
  }
}