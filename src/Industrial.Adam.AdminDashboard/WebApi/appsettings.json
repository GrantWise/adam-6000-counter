{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/admin-dashboard-api-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "AdminDashboard.API",
      "Environment": "Production"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=adam_counters;Username=industrial_system;Password=IndustrialCounter2024!@#$;Include Error Detail=true",
    "TimescaleDB": "Host=localhost;Port=5433;Database=adam_counters;Username=industrial_system;Password=IndustrialCounter2024!@#$;Include Error Detail=true"
  },
  "IndustrialSecurity": {
    "JwtSettings": {
      "SecretKey": "8f9e2a1b5c6d3e7f4g8h9i2j5k6l3m7n8o9p2q5r6s3t7u8v9w2x5y6z3a7b8c9d",
      "Issuer": "Industrial.Adam.System",
      "Audience": "Industrial.Adam.APIs",
      "AccessTokenExpirationMinutes": 60,
      "RefreshTokenExpirationDays": 7,
      "RequireHttps": false
    },
    "CorsSettings": {
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "https://localhost:3000",
        "https://localhost:5173"
      ],
      "AllowCredentials": true
    },
    "RateLimiting": {
      "Enabled": true,
      "RequestsPerMinute": 100,
      "BurstLimit": 20
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5004"
      }
    }
  }
}