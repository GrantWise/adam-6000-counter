# Industrial ADAM Platform - Environment Configuration
# Copy this file to .env.local for development

# API Configuration - Real Backend Services
VITE_LOGGER_API_HOST=localhost
VITE_LOGGER_API_PORT=5139
VITE_LOGGER_API_HTTPS=false

VITE_OEE_API_HOST=localhost
VITE_OEE_API_PORT=5140
VITE_OEE_API_HTTPS=false

VITE_SECURITY_API_HOST=localhost
VITE_SECURITY_API_PORT=5139
VITE_SECURITY_API_HTTPS=false

VITE_SCHEDULING_API_HOST=localhost
VITE_SCHEDULING_API_PORT=5141
VITE_SCHEDULING_API_HTTPS=false

# Authentication Configuration
VITE_AUTH_TOKEN_STORAGE=sessionStorage
VITE_AUTH_REFRESH_THRESHOLD_MINUTES=5

# Application Configuration
VITE_APP_NAME="Industrial ADAM Platform"
VITE_APP_VERSION=2.0.0
VITE_APP_ENVIRONMENT=development

# CFR Part 11 Compliance
VITE_CFR_COMPLIANCE_MODE=strict
VITE_SYNTHETIC_DATA_ALLOWED=false
VITE_AUDIT_LOGGING_ENABLED=true

# Development Settings
VITE_DEV_MOCK_APIs=false
VITE_DEV_SHOW_DEBUG=true
VITE_DEV_API_DELAY_MS=0