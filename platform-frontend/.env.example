# Industrial ADAM Platform - Frontend Environment Configuration
# Copy this file to .env.local for local development

# API Endpoints
VITE_LOGGER_API_HOST=localhost
VITE_LOGGER_API_PORT=5139
VITE_LOGGER_API_HTTPS=false

VITE_OEE_API_HOST=localhost
VITE_OEE_API_PORT=5140
VITE_OEE_API_HTTPS=false

VITE_SECURITY_API_HOST=localhost
VITE_SECURITY_API_PORT=5139
VITE_SECURITY_API_HTTPS=false

VITE_SCHEDULING_API_HOST=localhost
VITE_SCHEDULING_API_PORT=5141
VITE_SCHEDULING_API_HTTPS=false

# Development Settings
VITE_APP_ENV=development
VITE_LOG_LEVEL=debug

# CFR Part 11 Compliance
VITE_AUDIT_MODE=true
VITE_DATA_INTEGRITY_CHECKS=true

# Feature Flags
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_SIMULATED_DATA_WARNINGS=true
VITE_STRICT_DATA_QUALITY=true